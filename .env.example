# =========================================================================
# Copy to .env.local:   Copy-Item .env.example .env.local
# .env.local is gitignored by Next.js. Never commit real keys.
# =========================================================================

# Supabase Dashboard -> Project Settings -> API
# "Project URL" and the "anon / public" key. Both are safe in the browser:
# every table is locked down by row-level security.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# -------------------------------------------------------------------------
# SERVER-ONLY. No NEXT_PUBLIC_ prefix, so this never reaches the browser.
# This is what signs citizen QR codes. If it leaks, anyone can mint a QR
# that impersonates any citizen, so treat it like a password.
#
# Generate one (PowerShell):
#   -join ((1..48) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
# -------------------------------------------------------------------------
QR_SIGNING_SECRET="replace-with-a-random-32-plus-character-string"

# How long a citizen's QR stays valid, in seconds. 86400 = 24h.
# Lower it for a tighter rotation window; the app auto-refreshes the code
# one minute before it lapses while the screen is open.
QR_TTL_SECONDS="86400"
