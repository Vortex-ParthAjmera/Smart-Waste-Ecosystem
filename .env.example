# ============================================================
# Smart Waste Ecosystem — Environment Variables
# Copy to .env.local and fill in values.
# NEVER commit real .env* files.
# ============================================================

# --- Supabase (Cloud) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Supabase Auth ---
NEXT_PUBLIC_SUPABASE_PROJECT_REF=your-project-ref

# --- Phone OTP Provider (Tier 1 target) ---
# Enable only when provider preflight passes
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# --- Google OAuth (Tier 1 target) ---
# Enable only when redirect URIs pass preflight
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Edge Gateway ---
EDGE_GATEWAY_CODE=EDGE-001
EDGE_GATEWAY_SECRET=your-gateway-secret
EDGE_CLOUD_URL=https://your-project.vercel.app/api/v1
EDGE_PORT=8000

# --- ESP32 Device ---
DEVICE_CODE=ESP32-001
DEVICE_SECRET=your-device-shared-secret

# --- Camera ---
CAMERA_SOURCE_URL=http://192.168.1.100:8080/video
CAMERA_FRAME_WIDTH=640
CAMERA_FRAME_HEIGHT=480
CAMERA_CAPTURE_TIMEOUT_MS=3000

# --- Local ML ---
ML_MODEL_PATH=./models/yolov8n-waste.onnx
ML_WEIGHTS_SHA256=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789
ML_CLASS_MAP_PATH=./class-map.json
ML_INFERENCE_TIMEOUT_MS=5000

# --- Demo Controls ---
DEMO_SIMULATION_ENABLED=false
DEMO_RATE_LIMIT_PER_MINUTE=5

# --- Database (Local Supabase) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
